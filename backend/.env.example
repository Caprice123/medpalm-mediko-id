# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/medpalm?schema=public"

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-use-strong-random-string
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-from-console.cloud.google.com

# Google Gemini AI
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend URL (for Xendit payment redirects)
FRONTEND_URL=http://localhost:3000

# Xendit Payment Gateway
# Get your keys from: https://dashboard.xendit.co/settings/developers#api-keys
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
# Webhook verification token (set this in Xendit dashboard under Webhooks settings)
XENDIT_WEBHOOK_TOKEN=your_custom_webhook_verification_token_here

# iDrive e2 Cloud Storage (S3-compatible)
# Get your credentials from: https://www.idrive.com/e2/
IDRIVE_E2_ACCESS_KEY=your_idrive_e2_access_key
IDRIVE_E2_SECRET_KEY=your_idrive_e2_secret_key
IDRIVE_E2_ENDPOINT=your_idrive_e2_endpoint_url
IDRIVE_E2_BUCKET=your_bucket_name
IDRIVE_E2_REGION=us-east-1

# Bunny Stream (for subtopic video uploads and embed player)
# Stream library from: https://dash.bunny.net/stream → select library → API
BUNNY_STREAM_API_KEY=your-bunny-stream-api-key
BUNNY_STREAM_LIBRARY_ID=your-library-id
# Custom embed domain configured in Bunny Stream library settings (optional)
# If not set, falls back to: iframe.mediadelivery.net/embed/{libraryId}/{videoId}
BUNNY_STREAM_EMBED_DOMAIN=embed.mediko.id

# Security: refuse to boot on a Node.js runtime missing the 2026-10-21 fixes
# (CVE-2026-111497 Brotli RCE, TLS/DNS flaws). Default is warn-only.
# Patched runtimes: v22.23.4, v24.22.1, v26.12.1
NODE_VERSION_ENFORCE=false
